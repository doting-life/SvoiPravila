# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Local default: fake. Production: openai.
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# Local default: memory. Production: postgres.
RELATIONSHIP_BACKEND=memory
DATABASE_URL=postgresql+asyncpg://svoi_pravila:svoi_pravila@postgres:5432/svoi_pravila

# Local default: memory. Production: redis.
CHECKPOINT_BACKEND=memory
REDIS_URL=redis://redis:6379/0
REDIS_CHECKPOINT_TTL_SECONDS=1200

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://example.com/v1/telegram/webhook
TELEGRAM_DEFAULT_WORKFLOW=soften

# Mini App initData validation
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
